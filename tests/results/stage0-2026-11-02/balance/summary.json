{
  "band_status": "asserting",
  "bands": [
    {
      "agg": "min",
      "id": "roster-floor",
      "metric": "min_fit",
      "policies": [
        "all"
      ],
      "test": ">=",
      "value": 10.0,
      "why": "the roster must never collapse: the worst week of the worst seed still fields a team"
    },
    {
      "agg": "max",
      "id": "roster-weeks",
      "metric": "weeks_fit_below_12",
      "policies": [
        "all"
      ],
      "test": "<=",
      "value": 8.0,
      "why": "fewer than 12 fit is a week of refusals; a fifth of the campaign is too many"
    },
    {
      "agg": "max",
      "id": "money-deficit",
      "metric": "weeks_below_zero",
      "policies": [
        "all"
      ],
      "test": "<=",
      "value": 8.0,
      "why": "a negative account freezes hiring, training and kit"
    },
    {
      "agg": "min",
      "id": "money-debt",
      "metric": "balance_min",
      "policies": [
        "all"
      ],
      "test": ">=",
      "value": -75000.0,
      "why": "no bottomless debt in the worst seed"
    },
    {
      "agg": "mean",
      "id": "money-end",
      "metric": "balance_end",
      "policies": [
        "all"
      ],
      "test": ">=",
      "value": 0.0,
      "why": "the department should not end the campaign bankrupt"
    },
    {
      "agg": "mean",
      "id": "coverage",
      "metric": "unattended",
      "policies": [
        "all"
      ],
      "test": "<=",
      "value": 48.0,
      "why": "calls left unattended measured the roster collapse (48-80 on 28 Oct)"
    },
    {
      "agg": "mean",
      "id": "deaths",
      "metric": "officers_killed",
      "policies": [
        "all"
      ],
      "test": "<=",
      "value": 8.0,
      "why": "13-16 of 20 died across three runs; a run is meant to cost some officers, not most"
    },
    {
      "agg": "max",
      "id": "lethality",
      "metric": "officers_killed_per_op",
      "policies": [
        "all"
      ],
      "test": "<=",
      "value": 0.15,
      "why": "0.21-0.25 per operation on 28 Oct; a fifth of a squad per call is what broke the roster"
    },
    {
      "agg": "mean",
      "id": "civilians",
      "metric": "civ_killed",
      "policies": [
        "all"
      ],
      "test": "<=",
      "value": 6.0,
      "why": "the crowd cliff (P1.B) is measured here: 52 civilians in 8 quiet rallies at trauma 14"
    },
    {
      "agg": "mean",
      "id": "allies-held",
      "metric": "allies_lost_end",
      "policies": [
        "all"
      ],
      "test": "<=",
      "value": 2.0,
      "why": "0 of 4 allies survived every 28 Oct run"
    },
    {
      "agg": "mean",
      "id": "ally-recovery",
      "metric": "allies_regained",
      "policies": [
        "all"
      ],
      "test": ">=",
      "value": 0.25,
      "why": "an ally lost must be winnable back at least once across a matrix (P1.E)"
    },
    {
      "agg": "mean",
      "id": "score",
      "metric": "run_score",
      "policies": [
        "all"
      ],
      "test": ">=",
      "value": 0.0,
      "why": "restraint should out-score ruin; -2207 to -829 on 28 Oct"
    },
    {
      "agg": "mean",
      "id": "election",
      "metric": "kept_share",
      "policies": [
        "all"
      ],
      "test": ">=",
      "value": 0.5,
      "why": "a chief who plays sensibly keeps the office more often than not"
    }
  ],
